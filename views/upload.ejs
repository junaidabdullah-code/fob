<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Upload Project | FOB</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      background: linear-gradient(135deg, #e0fbfc 0%, #c2f0f7 55%, #a8e8f0 100%);
      color: #0f3d44;
      padding: 2rem 1rem;
      position: relative;
      overflow-x: hidden;
    }

    body::before,
    body::after {
      content: "";
      position: absolute;
      background: rgba(255, 255, 255, 0.4);
      animation: float 9s ease-in-out infinite;
      pointer-events: none;
    }
    body::before { width: 220px; height: 220px; top: -50px; left: -50px; }
    body::after  { width: 300px; height: 300px; bottom: -90px; right: -70px; animation-delay: -4s; }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50%      { transform: translateY(-22px); }
    }

    .card {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 520px;
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 2px solid #0891b2;
      padding: 2.5rem 2rem;
      animation: pop 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }

    @keyframes pop {
      from { opacity: 0; transform: translateY(14px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .brand {
      text-align: center;
      font-size: 1.6rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #0891b2;
      margin-bottom: 0.4rem;
    }

    h1 {
      text-align: center;
      font-size: 1.1rem;
      font-weight: 600;
      color: #0f3d44;
      margin-bottom: 1.75rem;
    }

    .alert {
      padding: 0.7rem 0.9rem;
      margin-bottom: 1.25rem;
      font-size: 0.88rem;
      border: 2px solid #dc2626;
      background: #fee2e2;
      color: #991b1b;
    }

    .form {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .field label {
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      color: #4a7278;
    }

    .field input,
    .field textarea {
      padding: 0.7rem 0.85rem;
      font-size: 0.98rem;
      font-family: inherit;
      color: #0f3d44;
      background: #ffffff;
      border: 2px solid #0891b2;
      outline: none;
      transition: box-shadow 0.15s ease;
      width: 100%;
    }

    .field textarea {
      resize: vertical;
      min-height: 90px;
      line-height: 1.5;
    }

    .field input::placeholder,
    .field textarea::placeholder {
      color: #9ab8bc;
    }

    .field input:focus,
    .field textarea:focus {
      box-shadow: 0 0 0 3px rgba(8, 145, 178, 0.25);
    }

    .char-count {
      align-self: flex-end;
      font-size: 0.72rem;
      color: #9ab8bc;
      font-weight: 600;
    }

    .drop-zone {
      display: block;
      border: 2px dashed #0891b2;
      background: rgba(224, 251, 252, 0.5);
      padding: 2.5rem 1.5rem;
      text-align: center;
      cursor: pointer;
      transition: background 0.2s ease, border-color 0.2s ease;
    }

    .drop-zone:hover {
      background: rgba(168, 232, 240, 0.6);
    }

    .drop-zone.dragover {
      background: rgba(34, 211, 238, 0.25);
      border-style: solid;
    }

    .drop-zone input { display: none; }

    .drop-icon {
      width: 48px;
      height: 48px;
      margin: 0 auto 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px solid #0891b2;
      color: #0891b2;
    }

    .drop-icon svg {
      width: 24px;
      height: 24px;
      stroke: currentColor;
      stroke-width: 2;
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .drop-title {
      font-weight: 700;
      color: #0f3d44;
      font-size: 1rem;
      margin-bottom: 0.35rem;
    }

    .drop-hint {
      font-size: 0.82rem;
      color: #4a7278;
    }

    .drop-hint span {
      color: #0891b2;
      font-weight: 700;
      text-decoration: underline;
    }

    .selected-file {
      display: none;
      align-items: center;
      gap: 0.75rem;
      padding: 0.7rem 0.9rem;
      border: 2px solid #0891b2;
      background: #fff;
      font-size: 0.88rem;
    }

    .selected-file.show { display: flex; }

    .selected-file .name {
      flex: 1;
      font-weight: 600;
      color: #0f3d44;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .selected-file .size {
      color: #7b9ea4;
      font-size: 0.8rem;
      flex-shrink: 0;
    }

    .progress-wrap {
      display: none;
      flex-direction: column;
      gap: 0.4rem;
    }

    .progress-wrap.show { display: flex; }

    .progress-track {
      height: 8px;
      background: rgba(8, 145, 178, 0.15);
      border: 2px solid #0891b2;
      overflow: hidden;
    }

    .progress-bar {
      height: 100%;
      width: 0%;
      background: #0891b2;
      transition: width 0.15s ease;
    }

    .progress-label {
      font-size: 0.78rem;
      color: #4a7278;
      font-weight: 600;
      text-align: right;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.75rem 1.5rem;
      font-size: 0.95rem;
      font-weight: 700;
      font-family: inherit;
      letter-spacing: 0.02em;
      text-decoration: none;
      cursor: pointer;
      background: transparent;
      color: #0891b2;
      border: 2px solid #0891b2;
      transition: background 0.2s ease, color 0.2s ease;
    }

    .btn:hover { background: #0891b2; color: #fff; }
    .btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .btn:disabled:hover { background: transparent; color: #0891b2; }

    .alt {
      text-align: center;
      margin-top: 1.5rem;
      font-size: 0.88rem;
      color: #4a7278;
    }

    .alt a {
      color: #0891b2;
      font-weight: 700;
      text-decoration: none;
      border-bottom: 2px solid transparent;
      transition: border-color 0.15s ease;
    }

    .alt a:hover { border-bottom-color: #0891b2; }

    @media (max-width: 480px) {
      .card { padding: 2rem 1.25rem; }
    }
  </style>
</head>
<body>
  <main class="card">
    <div class="brand">FOB Gallery</div>
    <h1>Upload a Project</h1>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert"><%= error %></div>
    <% } %>

    <form id="upload-form" action="/upload" method="POST" enctype="multipart/form-data" class="form">

      <div class="field">
        <label for="title">Project Title</label>
        <input
          type="text"
          id="title"
          name="title"
          placeholder="e.g. Final Year Report"
          required
          maxlength="120"
          autocomplete="off"
        />
        <span class="char-count" id="title-count">0 / 120</span>
      </div>

      <div class="field">
        <label for="description">Description (optional)</label>
        <textarea
          id="description"
          name="description"
          rows="3"
          placeholder="Short description of your project"
          maxlength="500"
        ></textarea>
        <span class="char-count" id="desc-count">0 / 500</span>
      </div>

      <label class="drop-zone" id="drop-zone" for="file-input">
        <input type="file" id="file-input" name="file" required />
        <div class="drop-icon">
          <svg viewBox="0 0 24 24">
            <path d="M12 3v14" />
            <path d="M6 9l6-6 6 6" />
            <path d="M4 21h16" />
          </svg>
        </div>
        <div class="drop-title">Drag & drop or click to browse</div>
        <div class="drop-hint">Max file size: <span>50 MB</span></div>
      </label>

      <div class="selected-file" id="selected-file">
        <span class="name" id="file-name"></span>
        <span class="size" id="file-size"></span>
      </div>

      <div class="progress-wrap" id="progress-wrap">
        <div class="progress-track">
          <div class="progress-bar" id="progress-bar"></div>
        </div>
        <div class="progress-label" id="progress-label">0%</div>
      </div>

      <button type="submit" class="btn" id="submit-btn">Upload Project</button>
    </form>

    <p class="alt">
      <a href="/">← Back to Gallery</a>
    </p>
  </main>

  <script>
    (function () {
      const dropZone = document.getElementById("drop-zone");
      const input = document.getElementById("file-input");
      const selected = document.getElementById("selected-file");
      const nameEl = document.getElementById("file-name");
      const sizeEl = document.getElementById("file-size");
      const form = document.getElementById("upload-form");
      const btn = document.getElementById("submit-btn");
      const titleEl = document.getElementById("title");
      const descEl = document.getElementById("description");
      const titleCount = document.getElementById("title-count");
      const descCount = document.getElementById("desc-count");
      const progressWrap = document.getElementById("progress-wrap");
      const progressBar = document.getElementById("progress-bar");
      const progressLabel = document.getElementById("progress-label");

      function formatSize(bytes) {
        if (bytes < 1024) return bytes + " B";
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + " KB";
        return (bytes / 1024 / 1024).toFixed(1) + " MB";
      }

      function showSelected(file) {
        if (!file) {
          selected.classList.remove("show");
          return;
        }
        nameEl.textContent = file.name;
        sizeEl.textContent = formatSize(file.size);
        selected.classList.add("show");
      }

      // ---- file picker ----
      input.addEventListener("change", () => {
        showSelected(input.files[0]);
      });

      // ---- drag & drop ----
      ["dragenter", "dragover"].forEach((ev) => {
        dropZone.addEventListener(ev, (e) => {
          e.preventDefault();
          dropZone.classList.add("dragover");
        });
      });

      ["dragleave", "drop"].forEach((ev) => {
        dropZone.addEventListener(ev, (e) => {
          e.preventDefault();
          dropZone.classList.remove("dragover");
        });
      });

      dropZone.addEventListener("drop", (e) => {
        const files = e.dataTransfer.files;
        if (files.length > 0) {
          input.files = files;
          showSelected(files[0]);
        }
      });

      // ---- character counters ----
      titleEl.addEventListener("input", () => {
        titleCount.textContent = titleEl.value.length + " / 120";
      });
      descEl.addEventListener("input", () => {
        descCount.textContent = descEl.value.length + " / 500";
      });

      // ---- client-side validation + submit ----
      form.addEventListener("submit", (e) => {
        const title = titleEl.value.trim();
        if (!title) {
          e.preventDefault();
          titleEl.focus();
          return;
        }
        if (!input.files[0]) {
          e.preventDefault();
          dropZone.scrollIntoView({ behavior: "smooth", block: "center" });
          return;
        }

        btn.textContent = "Uploading…";
        btn.disabled = true;
        progressWrap.classList.add("show");

        // Progress bar animation while the server processes (not a real
        // upload progress — XHR upload events would be required for that).
        let pct = 0;
        const tick = setInterval(() => {
          pct = Math.min(pct + Math.random() * 12, 92);
          progressBar.style.width = pct + "%";
          progressLabel.textContent = Math.round(pct) + "%";
        }, 180);

        form.addEventListener("load", () => clearInterval(tick), { once: true });
        window.addEventListener("beforeunload", () => clearInterval(tick), { once: true });
      });
    })();
  </script>
</body>
</html>